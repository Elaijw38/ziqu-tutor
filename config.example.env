# 复制成 config.local.env 后填写三行即可；这个文件不要提交到 git（已在 .gitignore）
# 任选一家，三行都写成你自己的
# --- 阿里云百炼（推荐，校园有额度/易申请） ---
ZQ_LLM_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
ZQ_LLM_KEY=sk-填你的key
ZQ_LLM_MODEL=qwen-plus
# --- DeepSeek ---
# ZQ_LLM_BASE=https://api.deepseek.com/v1
# ZQ_LLM_KEY=sk-填你的key
# ZQ_LLM_MODEL=deepseek-chat
# --- 火山方舟（模型名填 endpoint id） ---
# ZQ_LLM_BASE=https://ark.cn-beijing.volces.com/api/v3
# ZQ_LLM_KEY=填你的key
# ZQ_LLM_MODEL=ep-xxxxxxxx
# --- 智谱 ---
# ZQ_LLM_BASE=https://open.bigmodel.cn/api/paas/v4
# ZQ_LLM_KEY=填你的key
# ZQ_LLM_MODEL=glm-4-plus
# --- 本地 Ollama（断网也能演示，key 随意填） ---
# ZQ_LLM_BASE=http://127.0.0.1:11434/v1
# ZQ_LLM_KEY=ollama
# ZQ_LLM_MODEL=qwen2.5:7b
# 超时秒数（默认 25）
# ZQ_LLM_TIMEOUT=25

# --- 公网部署（只在本机跑可以全部不填） ---
# 监听地址：默认 127.0.0.1 只给本机；对外开放填 0.0.0.0
# ZQ_HOST=0.0.0.0
# 端口：平台（Render/Fly/容器）一般会自己注入 PORT，本机默认 8770
# PORT=8770
# 邀请码：设了之后，页面和接口都要凭码进入（分享链接必开）
# ZQ_ACCESS_CODE=zzu2026
# 单 IP 每小时提问上限，防止公开链接被刷模型额度；0 或不填表示不限
# ZQ_RATE_PER_HOUR=60

# --- Dify（可选，配了会优先走 Dify 链路） ---
# ZQ_DIFY_BASE=https://api.dify.ai/v1
# ZQ_DIFY_KEY=app-填你的应用key
